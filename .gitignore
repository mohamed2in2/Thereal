# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# env files (secrets — never commit)
.env
.env.local
.env.*.local
!.env.example

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

/src/generated/prisma
*.db
*.db-journal
/dev.db
/dev.db-journal
prisma/*.db
prisma/*.db-journal
prisma/backups/

# WhatsApp Baileys Auth & Logs
whatsapp-auth/
logs/

# Python bytecode from the curriculum ingestion scripts
__pycache__/
*.pyc

# Local video uploads & encrypted DRM assets
uploads/
bin/

# Dev/debug scripts committed to root — exclude from future commits
create_exam.js
create_exam.ts
fix.js
fix-ast.js
fix-broken.js
fix-broken4.js
fix-folders.js
fix-logs.js
seed-data.js
test-db.js
test-payload.js
test-payload2.js
test-prisma.js
test_claude.py
prisma.config.ts.backup

# Log / output files
dev-server.log
test-out.txt
build-out.txt

# Runtime state
state.json

# Debug session archives and large binary blobs
*.zip
*.deb
*.deb.1
*.deb.2
